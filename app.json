{
  "expo": {
    "name": "TrickyHr",
    "slug": "trickyhr",
    "version": "3.5.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "trickyhr",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mykevit.kevit",
      "buildNumber": "4",

      "infoPlist": {
        "NSCameraUsageDescription": "TrickyHR uses the camera to scan attendance QR codes and upload employee profile or attendance photos.",

        "NSPhotoLibraryUsageDescription": "TrickyHR uses the photo library so employees can upload profile and attendance images.",

        "NSMicrophoneUsageDescription": "TrickyHR uses the microphone for voice or video communication features.",

        "NSLocationWhenInUseUsageDescription": "TrickyHR uses your location while you use the app to verify workplace attendance and QR check-ins.",

        "UIBackgroundModes": ["fetch"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mykevit.www.trickyhr",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/adptive-icon.png",
        "backgroundImage": "./assets/images/background.png"
      },
      "versionCode": 116,
      "userInterfaceStyle": "automatic",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrickyHR uses your location while you use the app to verify workplace attendance and QR check-ins.",

          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "ndkVersion": "26.1.10909125",
            "usesCleartextTraffic": true,
            "packagingOptions": {
              "pickFirst": []
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "novaframes"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bd55208-929c-4904-8e56-61fa84d11eca"
      }
    }
  }
}
